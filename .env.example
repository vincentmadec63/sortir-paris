# Copie ce fichier en .env (jamais commité) et remplis avec les valeurs
# de ton projet Supabase : Project Settings -> API.
# VITE_SUPABASE_ANON_KEY est la clé "anon public" -- prévue pour être
# exposée côté client, protégée par les règles Row Level Security côté
# base de données. Ne jamais utiliser ici la clé "service_role".
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
